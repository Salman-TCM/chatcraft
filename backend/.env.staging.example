# ChatCraft AI — Staging environment variables
# Mirror of production with staging-specific endpoints and test keys

ENVIRONMENT=staging
DEBUG=false
SECRET_KEY=                           # different from production

DATABASE_URL=                         # Railway staging postgres plugin
REDIS_URL=                            # Upstash staging database

CORS_ORIGINS=["https://staging.chatcraft.ai","https://*.vercel.app"]

# Use Stripe TEST keys in staging — never live keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Use test/sandbox API keys where available
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ELEVENLABS_API_KEY=

SUPABASE_URL=                         # separate staging Supabase project
SUPABASE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=staging@chatcraft.ai

SENTRY_DSN=                           # separate Sentry staging environment

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=chatcraft-uploads-staging
AWS_REGION=us-east-1
