# Bootstrap template ONLY — copied to upstream-backend.conf (gitignored,
# untracked) on first server setup. From then on, upstream-backend.conf is
# the live, runtime-only state that scripts/deploy/deploy.sh rewrites on
# every deploy. It must stay untracked: this repo directory gets
# `git reset --hard` on every deploy, which would otherwise clobber
# whichever slot is actually live with whatever's committed here.
#
# map-based variable so nginx resolves the container name at request time
# (via resolver 127.0.0.11) rather than at startup — prevents "host not
# found in upstream" on a fresh server before the slot container exists.
map $host $backend_upstream {
  default "backend_blue:8000";
}
