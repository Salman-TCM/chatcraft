# =============================================================================
# ChatCraft AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVICE PORTS  (host-side; change if local ports are already taken)
# -----------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
CLAMAV_HOST_PORT=3310


# -----------------------------------------------------------------------------
# POSTGRESQL CREDENTIALS
# -----------------------------------------------------------------------------
POSTGRES_USER=chatcraft
POSTGRES_PASSWORD=chatcraft                 # change in production
POSTGRES_DB=chatcraft


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
ENVIRONMENT=development                     # development | staging | production
DEBUG=true
SECRET_KEY=                                 # openssl rand -hex 32


# -----------------------------------------------------------------------------
# AUTH
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000          # Set to your production URL in prod
NEXTAUTH_SECRET=                            # openssl rand -hex 32

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback


# -----------------------------------------------------------------------------
# AI / LLM PROVIDERS
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=                          # https://console.anthropic.com/keys
OPENAI_API_KEY=                             # https://platform.openai.com/api-keys
GOOGLE_AI_API_KEY=                          # https://aistudio.google.com/app/apikey
GROQ_API_KEY=                               # https://console.groq.com/keys
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=


# -----------------------------------------------------------------------------
# VOICE — ElevenLabs
# https://elevenlabs.io/app/settings/api-keys
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=


# -----------------------------------------------------------------------------
# PAYMENTS — Stripe
# https://dashboard.stripe.com/apikeys  (test keys: sk_test_ / pk_test_)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=                      # Dashboard > Webhooks > signing secret
STRIPE_CONNECT_CLIENT_ID=                   # For Stripe Connect (creator payouts)

STRIPE_PRICE_FREE=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_CREATOR=


# -----------------------------------------------------------------------------
# STORAGE — AWS S3 (or Supabase Storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=chatcraft-uploads
AWS_REGION=us-east-1


# -----------------------------------------------------------------------------
# DATABASE URL
# Docker Compose builds this from POSTGRES_* above automatically.
# Override here only when using an external DB (Supabase, Neon, Railway, etc.)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
SUPABASE_URL=
SUPABASE_KEY=                               # Service role key (server-side only)


# -----------------------------------------------------------------------------
# REDIS
# Docker Compose uses redis://redis:6379/0 internally.
# Override here only when using an external Redis (Upstash, etc.)
# -----------------------------------------------------------------------------
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT  # Upstash TLS


# -----------------------------------------------------------------------------
# EMAIL — Resend
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com


# -----------------------------------------------------------------------------
# MONITORING & LOGGING
# -----------------------------------------------------------------------------
SENTRY_DSN=                                 # Backend Python DSN
NEXT_PUBLIC_SENTRY_DSN=                     # Frontend Next.js DSN
SLACK_ALERT_WEBHOOK_URL=                    # https://api.slack.com/messaging/webhooks
AXIOM_TOKEN=                                # https://app.axiom.co/settings/api-tokens
AXIOM_DATASET=chatcraft-logs


# -----------------------------------------------------------------------------
# ANALYTICS — PostHog
# https://app.posthog.com/project/settings
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com


# -----------------------------------------------------------------------------
# FRONTEND PUBLIC VARS  (exposed to browser; prefix NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# CHANNELS
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

X_API_KEY=
X_API_SECRET=


# -----------------------------------------------------------------------------
# CLOUD BROWSER — Browserbase
# https://www.browserbase.com/
# -----------------------------------------------------------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=


# -----------------------------------------------------------------------------
# WEB PUSH — VAPID keys
# Generate: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com


# -----------------------------------------------------------------------------
# APPLE WALLET — PKPass signing
# https://developer.apple.com/documentation/walletpasses
# -----------------------------------------------------------------------------
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_WWDR_PEM=
APPLE_PUSH_KEY_ID=
APPLE_PUSH_KEY_PEM=


# -----------------------------------------------------------------------------
# GOOGLE WALLET
# https://developers.google.com/wallet
# -----------------------------------------------------------------------------
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=              # JSON string of service account creds


# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
# CORS / URLs
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
