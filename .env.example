# =============================================================================
# ChatCraft AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
ENVIRONMENT=development                   # development | staging | production
DEBUG=false
SECRET_KEY=                               # openssl rand -hex 32


# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL via Supabase
# https://supabase.com/dashboard/project/_/settings/database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=                             # Service role key (server-side only)
SUPABASE_ANON_KEY=                        # Anon/public key (safe for frontend)


# -----------------------------------------------------------------------------
# REDIS — Upstash (production) or localhost (development)
# https://console.upstash.com
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0        # Dev: local Redis
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT  # Prod: Upstash TLS URL


# -----------------------------------------------------------------------------
# AUTH
# https://generate a secret: openssl rand -hex 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000        # Set to your production URL in prod
NEXTAUTH_SECRET=                          # openssl rand -hex 32

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# AI / LLM PROVIDERS
# -----------------------------------------------------------------------------

# Anthropic — https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google AI (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=


# -----------------------------------------------------------------------------
# VOICE — ElevenLabs
# https://elevenlabs.io/app/settings/api-keys
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=


# -----------------------------------------------------------------------------
# PAYMENTS — Stripe
# https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_ / pk_test_
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # From Stripe Dashboard > Webhooks
STRIPE_CONNECT_CLIENT_ID=ca_...          # For creator payouts (Stripe Connect)

# Stripe Price IDs — create in Dashboard > Products
STRIPE_PRICE_FREE=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_CREATOR=


# -----------------------------------------------------------------------------
# STORAGE — AWS S3 or Supabase Storage
# Using us-east-1 (London) by default for UK data residency
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=chatcraft-uploads
AWS_REGION=us-east-1


# -----------------------------------------------------------------------------
# EMAIL — Resend
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com


# -----------------------------------------------------------------------------
# MONITORING & LOGGING
# -----------------------------------------------------------------------------

# Sentry — https://sentry.io (create two projects: one Next.js, one Python)
SENTRY_DSN=                               # Backend (Python) DSN
NEXT_PUBLIC_SENTRY_DSN=                   # Frontend (Next.js) DSN

# Axiom — https://app.axiom.co/settings/api-tokens
AXIOM_TOKEN=
AXIOM_DATASET=chatcraft-logs

# PostHog — https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com


# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed frontend origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# FRONTEND — Public variables (exposed to browser, prefix NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
